  "features": [
    {
      "title": "Glossmax Pro Nedir?",
      "blocks": [
        {
          "heading": null,
          "text": "GLOSSMAX PRO high gloss levha; melamin kaplı MDF veya yonga levhanın yüzeyine tutkal ve UV akrilik lak uygulanmasıyla elde edilen dekoratif parlak paneldir. Calender Coating Inert teknolojisiyle yüksek yüzey kalitesi ve etkileyici parlaklık sağlar."
        }
      ]
    },
    {
      "title": "Avantajlar",
      "blocks": [
        {
          "heading": "Mükemmel performans",
          "text": "Etkileyici parlaklık, yüksek yüzey dayanımı, üstün kesim ve işlenebilirlik. Teslimatta folyo ve şilte koruması."
        },
        {
          "heading": "Mükemmel uyum",
          "text": "Medelam & Teknolam ile aynı renk ve desenler. Ön yüz parlak, arka yüz aynı dekor kağıdıyla renk bütünlüğü."
        },
        {
          "heading": "Dayanım",
          "text": "Kimyasallara ve renklenmeye dirençli, yüksek çizilme direnci, kolay temizlenebilirlik, yüksek çatlama direnci."
        }
      ]
    },
    {
      "title": "Koleksiyonlar",
      "blocks": [
        {
          "heading": "Yalın",
          "text": "11 düz/pigmentli renk: Lake Beyaz, Kumtaşı, Antrasit, Aytaşı, Dafne, Süper Beyaz, Piyano Siyah, Porselen Beyaz, Kutup Beyaz, Buz Gri, Kaşmir."
        },
        {
          "heading": "Doğal",
          "text": "Tunus Mermer (F291) — doğal mermer ışıltısı."
        }
      ]
    }
